#!/usr/bin/env bash
# Install agent skills for Claude Code, Codex, and OpenCode via npx skills CLI
# Re-runs whenever this file changes OR any skill in skills/ changes
# skills-hash: {{ output "find" (joinPath .chezmoi.sourceDir ".." "skills") "-type" "f" "-exec" "cat" "{}" "+" | sha256sum }}
set -euo pipefail

# Disable telemetry
export DISABLE_TELEMETRY=1

# Ensure mise shims are in PATH (provides npx from mise-managed Node)
export PATH="$HOME/.local/share/mise/shims:$PATH"

# On macOS, also ensure Homebrew is in PATH
if [[ "$(uname)" == "Darwin" ]]; then
    if [[ -x /opt/homebrew/bin/brew ]]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"
    elif [[ -x /usr/local/bin/brew ]]; then
        eval "$(/usr/local/bin/brew shellenv)"
    fi
fi

# Activate mise to regenerate shims if needed
if command -v mise &>/dev/null; then
    mise reshim 2>/dev/null || true
fi

if ! command -v npx &>/dev/null; then
    echo "npx not found — install Node via 'mise install node' first, skipping skills"
    exit 0
fi

# Install skills globally for each coding agent in use.
add_skill() {
    local source="$1"
    shift

    npx skills add "$source" \
        --global \
        --agent claude-code \
        --agent codex \
        --agent opencode \
        "$@" \
        --yes
}

echo "Installing agent skills..."

# Third-party skills (from GitHub)
add_skill akin-ozer/cc-devops-skills --skill dockerfile-generator
add_skill akin-ozer/cc-devops-skills --skill github-actions-validator
add_skill akin-ozer/cc-devops-skills --skill helm-validator
add_skill blader/humanizer --skill humanizer
add_skill VictoriaMetrics/skills --skill victoriametrics-query
add_skill VictoriaMetrics/skills --skill victorialogs-query

# Personal skills, including locally maintained frontend and React guidance.
# Install these last so a third-party installation cannot replace them.
# .chezmoiroot is "tilde", so go up one level for the repository root.
add_skill "{{ .chezmoi.sourceDir }}/.." --skill '*'

echo "Agent skills installed successfully."
