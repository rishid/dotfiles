{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>rishid/renovate-config:default.json5',
  ],
  platform: 'github',
  platformAutomerge: false,

  // Explicitly override Renovate's hardcoded default of 2
  // Don't rely on :disableRateLimiting coming through the preset chain
  prHourlyLimit: 0,
  prConcurrentLimit: 0,
  branchConcurrentLimit: 0,

  packageRules: [
    {
      matchUpdateTypes: ['minor', 'patch', 'pin', 'digest', 'lockFileMaintenance'],
      automerge: true,
      automergeType: 'branch',
      ignoreTests: true,
    },
    {
      matchPackageNames: ['openai/codex'],
      extractVersion: '^rust-v(?<version>.+)$',
    },
    {
      // The mise manager defaults aqua tools to github-tags, which picks up
      // non-release tags (e.g. opencode v2.x, argo-cd rc tags) and yields
      // uninstallable versions (404). aqua downloads release assets, so track
      // releases instead. aws/aws-cli, golang/go and python/cpython publish tags only.
      matchManagers: ['mise'],
      matchPackageNames: ['/^[^/]+\\/[^/]+$/', '!aws/aws-cli', '!golang/go', '!python/cpython'],
      overrideDatasource: 'github-releases',
    },
    {
      matchManagers: ['mise'],
      groupName: 'mise tools',
      automerge: true,
      automergeType: 'branch',
      ignoreTests: true,
    },
  ],
  onboarding: false,
  requireConfig: 'ignored',
}
